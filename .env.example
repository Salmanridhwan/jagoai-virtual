# Template kredensial jagoai-virtual
#
# Berkas ini HANYA memuat rahasia. Alamat, nama proyek, dan nama kanal
# semuanya ada di tenant/jagoai/office.toml karena bukan rahasia.
#
# Cara pakai:
#   cp .env.example tenant/jagoai/.env
#   lalu isi nilainya, berkas .env tidak pernah masuk git
#
# Aturan penulisan:
#   - satu NAMA=nilai per baris, tanpa spasi di sekitar tanda sama dengan
#   - tanpa tanda kutip, kecuali nilainya mengandung spasi
#   - komentar ditaruh di baris sendiri, bukan di belakang nilai
#   - awalan nama adalah slug tenant huruf besar
#
# Periksa tanpa membuka nilainya:
#   python -m app.cli env-check

# ---------------------------------------------------------------
# 1. Wajib sejak Fase 0
# ---------------------------------------------------------------
# Kunci API gerbang 9router, dipakai "models" dan "run".
# Alamatnya di office.toml, bidang gerbang.base_url.
# Nama variabel ini dirujuk oleh office.toml, bidang gerbang.kunci_env.
JAGOAI_ROUTER_KEY=

# ---------------------------------------------------------------
# 2. Bahan dan CDN, Fase 2
# ---------------------------------------------------------------
# Kunci API proyek CDN, untuk mengunggah bahan dari manusia.
# Dirujuk oleh office.toml, bidang bahan.cdn_kunci_env.
JAGOAI_CDN_API_KEY=
# Token JWT CDN, untuk mengunduh berkas yang butuh otorisasi.
# Dirujuk oleh office.toml, bidang bahan.cdn_jwt_env.
JAGOAI_CDN_JWT_TOKEN=

# ---------------------------------------------------------------
# 3. Kanal, Fase 4
# ---------------------------------------------------------------
# Token resmi API kanal. Tanpa token, Kiki berhenti di status
# siap_unggah_manual dan tidak boleh memakai jalur peramban.
JAGOAI_THREADS_TOKEN=
JAGOAI_INSTAGRAM_TOKEN=
JAGOAI_TIKTOK_TOKEN=

# ---------------------------------------------------------------
# 4. Yang TIDAK masuk berkas ini
# ---------------------------------------------------------------
# - base_url gerbang, cdn_url, nama proyek, dan nama kanal: di office.toml
# - Canva: memakai OAuth lewat MCP, bukan token di .env
# - Id brand kit Canva: di office.toml, bukan rahasia
# - Kata sandi basis data: proyek ini belum memakai basis data
# - Nilai apa pun: jangan menyalin isi berkas ini ke chat, log, atau vault
